# =============================================================================
# SKINAUDIT — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — only .env.example goes to git.
# =============================================================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=""

# --- Better Auth ---
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- OpenAI ---
OPENAI_API_KEY=""

# --- Weather API ---
WEATHER_API_KEY=""
WEATHER_API_PROVIDER="openweathermap"  # openweathermap | weatherapi

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SkinAudit"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="skinaudit-assets"
NEXT_PUBLIC_R2_PUBLIC_URL=""
